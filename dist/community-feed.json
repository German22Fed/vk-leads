edPost":1793444704000,"wallCheckedAt":1793635036268,"wallError":null,"events":[{"kind":"returned","at":1793440569631},{"kind":"frontier_transition","at":1793440569631}]},"collectorFeed":true},{"id":242786204,"name":"Шкатулка красоты | Марьяна Унку","screenName":"club242786204","city":"Калуга","category":"Beauty and Health","members":63,"posts":8,"avatar":true,"photo":"https://sun1-56.userapi.com/s/v1/ig2/qCN4mwuhQV5qQu45oo19wSUwPRS7E3n5DAq6uKA0Wjh_tK9NSpubXeWw_Ws9DLoMgh0O4MeIIDd1-TCWT4yo1UAz.jpg?quality=95&crop=1,165,639,639&as=32x32,48x48,72x72,108x108,160x160,240x240,360x360,480x480,540x540&ava=1&cs=200x200","cover":false,"coverUrl":"","canMessage":null,"description":"«Бьюти без иллюзий от Марьяны Унку. Переехала из Молдовы в Питер 6 лет назад — и с тех пор учусь балансировать между бытом, семьёй и собой. У меня трое детей, поэтому в приоритете — работающие средства, быстрые ритуалы и честные обзоры. Здесь только то, что я пробовала сама: никакой рекламы ради рекламы, только личный опыт. Покажу, как ухаживать за собой, когда времени в обрез, и помогу не потеряться в сотнях новинок. Присоединяйтесь!»","latestPost":1793630700,"source":"Рост ID · кандидат, создание не подтверждено","wallUnavailable":false,"verifiedAt":1793635036268,"verification":"groups.getById","firstSeen":1793440569631,"status":"new","available":true,"observation":{"verdict":"frontier_other_day","appearance":{"kind":"frontier_candidate","method":"frontier_transition","from":1793438089586,"to":1793440569631,"lowerId":242786157,"previousResponse":"placeholder","priorChecks":1},"checks":1,"firstChecked":1793440569021,"lastChecked":1793440569631,"missingChecks":0,"oldestObservedPost":1793446121000,"wallCheckedAt":1793635037426,"wallError":null,"events":[{"kind":"returned","at":1793440569631},{"kind":"frontier_transition","at":1793440569631}]},"collectorFeed":true},{"id":242786230,"name":"Творческая мастерская Светланы Носовой","screenName":"club242786230","city":"Самара","category":"Arts and Crafts","members":1,"posts":0,"avatar":true,"photo":"https://sun1-57.userapi.com/s/v1/ig2/AI5Zyzm2vx768iSL5x2J0_98UdXpEvwDLvvlm8Yuttbc61_TrL1rfxKFaz_59xqoKWklt1jJTxArMn0HvFlS-Kp9.jpg?quality=95&crop=0,0,1024,1024&as=32x32,48x48,72x72,108x108,160x160,240x240,360x360,480x480,540x540,640x640,720x720&ava=1&cs=200x200","cover":true,"coverUrl":"https://sun9-71.userapi.com/impf/J5GwAv4rlJ1cYUSo1gNwjU95Ci7yqvmCJCtcTA/QcEbrPsCsAc.jpg?size=1920x768&quality=95&crop=44,393,980,392&sign=43c1a2150ecfc6d8ede8bb89274c4d33&c_uniq_tag=2Bl4BtN8ayMQN9l5OIQRAitTVk0A9B61xqlmhXAAKJw&type=cover_group","canMessage":null,"description":"Приветствую Вас! Давайте знакомиться!Творчеством занимаюсь с 2011 года. Началось всё с того, что нужно было подарить очень творческому человеку подарок на свадьбу. Так я сделала свой первый Топиарий. Естественно осталось много материалов, так как подбор элементов подразумевает большой набор тканей, бус, цветов, декора и т.д. Начала делать Топиарии в комнаты, кухни, на праздники, в офисы, и новогодние экспозиции. Потом пришла идея магнитов на холодильник. Участвовала несколько раз на ярмарках в г. Самара. Там получила ещё больше вдохновения и сделала Топиарий больше 1 метра высотой. Захотелось большего. Освоила технику декупажа и начала изготовление чайных домиков. Ещё научилась шить развивающие книги для детей из фетра и текстиля. Потом дочка попросила сшить ей куклу и так родилась простенькая куколка. Потом я много читала, училась, покупала мастер-классы по пошиву текстильных кукол, и сшила свою первую шарнирную куклу. \nКонечно самым главным моим вдохновением является моя дочка. Она тоже посещает много мастер-классов, приносит поделки, и мне тоже очень хочется такое воплотить в жизнь. Так я научилась вязать подушку пончик.\nЯ имею постоянное место работы, но всегда нахожу время на творчество. Вяжу, клею, шью в машине, на даче, везде где можно и нельзя, лёжа, сидя, стоя🙂. Когда дети и взрослые получают подарки, выполненные мои руками, у них светятся глаза, они бурно реагируют на полученный подарок. Видно что они получили море положительных эмоций, а мне этого и надо для дальнейшего развития.\nУ меня ещё очень много идей в голове, и я очень хочу научить детей разного возраста и взрослых моим техникам. И из практики могу сказать, что человек получивший подарок ручной работы, потом сам начинает творить и вовлекает в процесс своих родных. Даже папы начинают пилить, строгать, крутить и клеить😊","latestPost":null,"source":"Рост ID · кандидат, создание не подтверждено","wallUnavailable":false,"verifiedAt":1793635037426,"verification":"groups.getById","firstSeen":1793440569631,"status":"new","available":true,"observation":{"verdict":"frontier_other_day","appearance":{"kind":"frontier_candidate","method":"frontier_transition","from":1793438089586,"to":1793440569631,"lowerId":242786157,"previousResponse":"placeholder","priorChecks":1},"checks":1,"firstChecked":1793440569021,"lastChecked":1793440569631,"missingChecks":0,"oldestObservedPost":null,"wallCheckedAt":1793635037969,"wallError":null,"events":[{"kind":"returned","at":1793440569631},{"kind":"frontier_transition","at":1793440569631}]},"collectorFeed":true},{"id":242786234,"name":"Фиксинг Сервис","screenName":"club242786234","city":"Санкт-Петербург","category":"Public page","members":1,"posts":0,"avatar":false,"photo":"https://sun1-87.userapi.com/impg/9FmuZgmL8ElIl3ap2VNqqvCJuR3XBTRcL5RstQ/IkJdt6c43WI.jpg?quality=96&as=32x32,48x48,72x72,108x108,160x160,240x240,360x360&sign=80af15cf714eb8b0c9b0fb180d3fb037&u=2YEVTlkKBuNPY0mjMeXr7QUGKVqyKPrs2k12FX4q3nE&cs=200x200","cover":false,"coverUrl":"","canMessage":null,"description":"Ремонт телевизоров и другой электроники.","latestPost":null,"source":"Рост ID · кандидат, создание не подтверждено","wallUnavailable":false,"verifiedAt":1793635037969,"verification":"groups.getById","firstSeen":1793440569631,"status":"new","available":true,"observation":{"verdict":"frontier_other_day","appearance":{"kind":"frontier_candidate","method":"frontier_trans