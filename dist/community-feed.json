8,1225,490&sign=5dbbbc8601729b5cd03b1c828b4ac0bc&c_uniq_tag=kuQ6t7g4ZQkYGFMQp-6uVNu6lO4nwZn8lGbfnbTHWhk&type=cover_group","canMessage":null,"description":"Школа чистоты и доброты  \"Красна девица\" представляет уроки по воспитанию нравственности и целомудрия у девочек!\n\nНа наших уроках у каждой девочки есть возможность:\n\n- окунуться в светлую мирную дружелюбную ДЕВИЧЬЮ безопасную атмосферу;\n- найти подруг-единомышленниц;\n- заглянуть внутрь себя, научиться прислушиваться к себе, к своему сердцу;\n- любить и принимать себя;\n- развить в себе истинные девичьи качества;\n- подготовиться к семейной жизни;\n- научиться уважать старших, уважать мужчин;\n- открыть свое сердце без страха и получить поддержку девичьего круга;\n- получить истинные уроки красоты\n\n- Уроки нравственности, направленные на девочек с 6 до 11 лет по темам целомудрия, верности, ценности семьи, женских обязанностей и развития женских черт характера.\n\nТаким образом, объединившись и размышляя, вместе вкладывая в наших детей самое лучшее, наш мир, наше окружение будет становиться здоровее, целомудреннее и осознаннее! \n\n(Школа не является образовательным учреждением начального и среднего образования. Обучение ведется в формах, не подлежащих лицензированию.)","latestPost":null,"source":"Рост ID · кандидат, создание не подтверждено","wallUnavailable":false,"verifiedAt":1793597612535,"verification":"groups.getById","firstSeen":1793511919020,"status":"new","available":true,"observation":{"verdict":"frontier_other_day","appearance":{"kind":"frontier_candidate","method":"frontier_transition","from":1793509489353,"to":1793511919020,"lowerId":242814362,"previousResponse":"placeholder","priorChecks":2},"checks":2,"firstChecked":1793511918453,"lastChecked":1793514344046,"missingChecks":0,"oldestObservedPost":null,"wallCheckedAt":1793597612912,"wallError":null,"events":[{"kind":"returned","at":1793511919020},{"kind":"frontier_transition","at":1793511919020}]},"collectorFeed":true},{"id":242814890,"name":"